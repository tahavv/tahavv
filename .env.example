# Set these in Vercel (Project Settings > Environment Variables).
# Resend API key (resend.com > API Keys), starts with re_.
NUXT_RESEND_API_KEY=
# An address on a domain verified in Resend. onboarding@resend.dev works for testing,
# but then Resend only delivers to the email address of your Resend account.
NUXT_CONTACT_FROM_EMAIL=
NUXT_CONTACT_FROM_NAME=Portfolio contact form
# Where contact form messages arrive.
NUXT_CONTACT_TO_EMAIL=
# Canonical URL used for SEO tags and the sitemap.
NUXT_PUBLIC_SITE_URL=https://taha-ayari.vercel.app
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to keep GA4 off;
# when set, it loads only after the visitor accepts the consent banner.
NUXT_PUBLIC_GA_ID=
# Search engine ownership tokens (content of the meta tag each tool gives you).
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BING_SITE_VERIFICATION=
